// iPrep Prisma Schema
// datasource: sqlite (local Phase 1) → postgresql (cloud Phase 2) — change provider + url only
// SQLite via prisma-client does not support Json or native enums.
// Json fields are stored as serialised JSON strings; enum fields are stored as plain strings.
// Type safety for these values is enforced by Zod schemas in @iprep/shared.

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    runtime      = "nodejs"
    moduleFormat = "esm"
}

datasource db {
    provider = "sqlite"
    // No url here — Prisma 7 receives the path programmatically via the better-sqlite3 driver adapter in client.ts
}

// ── Models ─────────────────────────────────────────────────────────────

model User {
    id        String   @id @default(cuid())
    email     String?  @unique
    name      String?
    tier      String   @default("FREE") // Tier: FREE | PRO | CLOUD
    createdAt DateTime @default(now())

    settings Settings?
    sessions Session[]
    apiKeys  ApiKey[]
}

model Settings {
    id     String @id @default(cuid())
    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    defaultProvider String  @default("deepgram-agent")
    defaultTutor    String  @default("alex")
    theme           String  @default("dark")
    voiceEnabled    Boolean @default(true)
    language        String  @default("en")
}

// Stores only a hash/reference — actual key bytes live in ~/.iprep/.keys (never in DB)
model ApiKey {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    provider  String // "deepgram" | "anthropic" | "gemini" | "openai" | "ollama" | "other"
    keyHash   String // bcrypt hash for reference/dedup; plaintext key stored in .keys file
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())

    @@unique([userId, provider])
}

// Seeded on first run — slug is the stable public identifier
model Package {
    id          String  @id @default(cuid())
    slug        String  @unique // "behavioral" | "technical" | "system-design" | "dsa" | "hr" | "pm"
    name        String
    type        String // PackageType: BEHAVIORAL | TECHNICAL | SYSTEM_DESIGN | DSA | HR | PM | CUSTOM
    description String
    questions   String // JSON: QuestionTemplate[]
    isPro       Boolean @default(false)

    sessions Session[]
}

// Seeded on first run — alex, priya, morgan
model Tutor {
    id           String  @id @default(cuid())
    slug         String  @unique // "alex" | "priya" | "morgan"
    name         String
    persona      String
    systemPrompt String
    voice        String // Deepgram voice ID (e.g. "aura-asteria-en")
    avatarUrl    String?
    isPro        Boolean @default(false)

    sessions Session[]
}

model Session {
    id        String  @id @default(cuid())
    userId    String
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    packageId String
    package   Package @relation(fields: [packageId], references: [id])
    tutorId   String
    tutor     Tutor   @relation(fields: [tutorId], references: [id])

    status   String @default("ACTIVE") // SessionStatus: ACTIVE | ENDED | ANALYZING | ANALYZED | FAILED
    mode     String @default("VOICE") // SessionMode: VOICE | TEXT
    provider String // voice/agent provider used ("deepgram-agent")

    startedAt     DateTime  @default(now())
    endedAt       DateTime?
    durationSec   Int?
    recordingPath String? // absolute local path or cloud URL (Phase 2)

    // Transcript written by server when session ends; null for voice-only sessions
    // where audio lives on Deepgram's side
    transcript String? // JSON: TranscriptMessage[] — { role, content, timestamp }[]

    analysis  Analysis?
    createdAt DateTime  @default(now())
}

model Analysis {
    id        String  @id @default(cuid())
    sessionId String  @unique
    session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    provider String // which provider ran this ("gemini-free" | "claude-cli" | ...)
    status   String @default("PENDING") // AnalysisStatus: PENDING | IN_PROGRESS | COMPLETED | FAILED

    // All score/feedback fields are null until status = COMPLETED
    // scores shape mirrors ScoreSchema in @iprep/shared:
    // { overall, communication, technicalAccuracy, problemSolving, confidence, clarity } (0–10 each)
    scores         String? // JSON: Scores
    strengths      String? // JSON: string[]
    improvements   String? // JSON: string[]
    answerFeedback String? // JSON: { question, userAnswer, feedback, score }[]
    report         String? // full markdown analysis narrative

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
