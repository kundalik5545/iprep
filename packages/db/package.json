{
  "name": "@iprep/db",
  "version": "0.0.1",
  "description": "iPrep Prisma ORM — SQLite (local) → Postgres (cloud)",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@iprep/shared": "workspace:*",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "prisma": "^7.8.0",
    "typescript": "^5.3.3"
  }
}
